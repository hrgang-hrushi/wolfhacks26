# Copy to web/.env (git-ignored) and fill in. Never commit real keys.

# Mapbox and API
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here
# Leave VITE_API_BASE_URL empty for relative /api routing (Vercel & Vite dev proxy)
VITE_API_BASE_URL=
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Maps for the phone dashboard (/m). Both are needed; without them /m uses MapLibre.
# Restrict the key by HTTP referrer to the deployed domain. The Map ID must be a vector map.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
