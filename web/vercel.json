{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/gov",
      "destination": "/index.html"
    },
    {
      "source": "/gov/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/m",
      "destination": "/index.html"
    },
    {
      "source": "/m/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/index.html"
    }
  ]
}
